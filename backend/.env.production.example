NODE_ENV=production
PORT=4000
FRONTEND_ORIGIN=https://fawn.example.com,https://www.fawn.example.com
PARCELS_GEOJSON_PATH=/app/parcels.geojson
ENABLE_MOCK_GROUPING=false
MOCK_TOTAL_HEGEGEMEINSCHAFTEN=11
MOCK_TOTAL_REVIERE=131
FRONTEND_DOMAIN=core.ipv64.de
API_DOMAIN=api.core.ipv64.de

JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=8h

DB_HOST=db
DB_PORT=5432
DB_USER=fawn_user
DB_PASSWORD=replace-with-strong-db-password
DB_NAME=fawn_rescue

AUTO_SEED=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Admin User
SEED_ADMIN_PASSWORD=replace-only-if-auto-seed-true
SEED_DISPATCHER_EMAIL=dispatcher@example.com
SEED_DISPATCHER_NAME=Dispatcher User
SEED_DISPATCHER_PASSWORD=replace-only-if-auto-seed-true
SEED_VIEWER_EMAIL=viewer@example.com
SEED_VIEWER_NAME=Viewer User
SEED_VIEWER_PASSWORD=replace-only-if-auto-seed-true
